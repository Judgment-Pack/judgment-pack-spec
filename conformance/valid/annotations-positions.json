{
  "specVersion": "0.4.0",
  "id": "https://example.com/judgment-packs/annotations-positions",
  "version": "0.1.0",
  "title": "Annotations on the pack, an outcome and two rules",
  "decision": {
    "intent": "Exercise one rule of RFC 0031 under the staged draft selector.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept",
      "extensions": {
        "org.judgmentpack.annotations": {
          "tier": "standard"
        }
      }
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "complete-request",
      "description": "A complete request is accepted.",
      "when": {
        "op": "fact",
        "path": "/request/complete",
        "operator": "equals",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "escalate",
      "extensions": {
        "org.judgmentpack.annotations": {
          "category": [
            "intake",
            "completeness"
          ],
          "review-cycle": "quarterly"
        },
        "com.example.authoring": {
          "draftedWith": "editor"
        }
      }
    },
    {
      "id": "incomplete-request",
      "description": "An incomplete request is referred.",
      "when": {
        "op": "fact",
        "path": "/request/complete",
        "operator": "equals",
        "value": false
      },
      "outcome": "refer",
      "onUnknown": "escalate",
      "extensions": {
        "org.judgmentpack.annotations": {
          "category": "completeness"
        }
      }
    }
  ],
  "extensions": {
    "org.judgmentpack.annotations": {
      "category": "intake",
      "review-cycle": "quarterly"
    }
  }
}
