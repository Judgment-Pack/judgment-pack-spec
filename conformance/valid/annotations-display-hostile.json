{
  "specVersion": "0.4.0",
  "id": "https://example.com/judgment-packs/annotations-display-hostile",
  "version": "0.1.0",
  "title": "Display-hostile annotation values",
  "decision": {
    "intent": "Exercise one rule of RFC 0031.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept every request.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "ignore",
      "extensions": {
        "org.judgmentpack.annotations": {
          "markup": "<b onclick=\"x\">hi</b>",
          "template": "{{ request.secret }}",
          "formula": "=HYPERLINK(\"https://example.com/x\")",
          "uri": "https://example.com/collect?id=1",
          "rtl": [
            "\u05e9\u05dc\u05d5\u05dd 2-1",
            "(\u05d0) [b]"
          ],
          "look-alike": "\u0430pprove",
          "combining": "a\u0301\u0302\u0303\u0304",
          "inner-space": "intake\u2003review",
          "outcome": "refer"
        }
      }
    }
  ]
}
