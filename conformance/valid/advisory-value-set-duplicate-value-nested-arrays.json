{
  "specVersion": "0.5.0",
  "id": "https://example.com/judgment-packs/value-set-duplicate-value-nested-arrays",
  "version": "0.1.0",
  "title": "Two entries compared for the advisory",
  "decision": {
    "intent": "Exercise one rule of RFC 0031.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept a request in a priority tier.",
      "when": {
        "op": "fact",
        "path": "/request/tier",
        "operator": "in",
        "valueSet": "priority-tiers"
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ],
  "valueSets": [
    {
      "id": "priority-tiers",
      "entries": [
        { "value": [[1], [2]] },
        { "value": [[1], [2]] }
      ]
    }
  ]
}
