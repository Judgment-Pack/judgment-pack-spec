{
  "specVersion": "0.5.0",
  "id": "https://example.com/judgment-packs/annotations-edge-neighbours",
  "version": "0.1.0",
  "title": "Characters next to white space, at both ends",
  "decision": {
    "intent": "Exercise one rule of RFC 0031.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept every request.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "ignore",
      "extensions": {
        "org.judgmentpack.annotations": {
          "category": [
            "!x!",
            "\u00a1x\u00a1",
            "\u167fx\u167f",
            "\u1681x\u1681",
            "\u1ffex\u1ffe",
            "\u2010x\u2010",
            "\u2027x\u2027",
            "\u2030x\u2030",
            "\u205ex\u205e",
            "\u2ffbx\u2ffb",
            "\u3001x\u3001"
          ]
        }
      }
    }
  ]
}
