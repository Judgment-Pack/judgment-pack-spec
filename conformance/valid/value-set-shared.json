{
  "specVersion": "0.4.0",
  "id": "https://example.com/judgment-packs/value-set-shared",
  "version": "0.1.0",
  "title": "One set referenced by two rules",
  "decision": {
    "intent": "Exercise one rule of RFC 0031 under the staged draft selector.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept a request in a priority tier.",
      "when": {
        "op": "fact",
        "path": "/request/tier",
        "operator": "in",
        "valueSet": "priority-tiers"
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    },
    {
      "id": "refer-request",
      "description": "Refer a request outside the priority tiers.",
      "when": {
        "op": "not",
        "condition": {
          "op": "fact",
          "path": "/request/tier",
          "operator": "in",
          "valueSet": "priority-tiers"
        }
      },
      "outcome": "refer",
      "onUnknown": "escalate"
    }
  ],
  "valueSets": [
    {
      "id": "priority-tiers",
      "entries": [
        {
          "value": "tier-1"
        },
        {
          "value": "tier-2"
        }
      ]
    }
  ]
}
