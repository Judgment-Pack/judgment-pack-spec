{
  "boundsFormatVersion": "1.1.0",
  "kinds": [
    {
      "kind": "db-role",
      "maxEntries": 10,
      "fields": [
        {
          "pointer": "/connectionLimit",
          "bound": {
            "maximum": 50
          }
        },
        {
          "pointer": "/connectionLimits",
          "bound": {
            "maximum": 10
          }
        },
        {
          "pointer": "/database",
          "bound": {
            "patterns": [
              "^entry:database/billing"
            ]
          }
        },
        {
          "pointer": "/privileges/*",
          "bound": {
            "enum": [
              "read",
              "write"
            ]
          }
        }
      ]
    }
  ]
}
