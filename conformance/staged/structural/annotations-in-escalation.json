{
  "specVersion": "0.4.0-draft",
  "id": "https://example.com/judgment-packs/annotations-in-escalation",
  "version": "0.1.0",
  "title": "Annotations in a position that refuses them",
  "decision": {
    "intent": "Exercise one rule of RFC 0031 under the staged draft selector.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept every request.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "unknown"
    ],
    "target": {
      "kind": "human-role",
      "name": "Intake reviewer"
    },
    "extensions": {
      "org.judgmentpack.annotations": {
        "category": "intake"
      }
    }
  }
}
