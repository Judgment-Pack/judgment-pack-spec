{
  "specVersion": "0.4.0-draft",
  "id": "https://example.com/judgment-packs/value-set-reference-bad-id",
  "version": "0.1.0",
  "title": "A malformed value set",
  "decision": {
    "intent": "Exercise one rule of RFC 0031 under the staged draft selector.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept a request in a priority tier.",
      "when": {
        "op": "fact",
        "path": "/request/tier",
        "operator": "in",
        "valueSet": "Tiers"
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ],
  "valueSets": [
    {
      "id": "priority-tiers",
      "entries": [
        {
          "value": "tier-1"
        },
        {
          "value": "tier-2"
        }
      ]
    }
  ]
}
