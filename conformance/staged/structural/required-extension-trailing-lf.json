{
  "specVersion": "0.4.0-draft",
  "id": "https://example.com/judgment-packs/required-extension-trailing-lf",
  "version": "0.1.0",
  "title": "A required extension name that ends in a line feed",
  "decision": {
    "intent": "Exercise one rule of RFC 0031 under the staged draft selector.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept every request.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "ignore",
      "extensions": {
        "com.example.review-policy": {
          "reviewMode": "two-person"
        }
      }
    }
  ],
  "metadata": {
    "requiredExtensions": [
      "com.example.review-policy\n"
    ]
  }
}
