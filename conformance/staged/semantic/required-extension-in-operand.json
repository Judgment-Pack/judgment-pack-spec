{
  "specVersion": "0.4.0-draft",
  "id": "https://example.com/judgment-packs/required-extension-in-operand",
  "version": "0.1.0",
  "title": "A required name only inside an operand",
  "decision": {
    "intent": "Exercise one rule of RFC 0031 under the staged draft selector.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept a request in a priority tier.",
      "when": {
        "op": "fact",
        "path": "/request/tier",
        "operator": "in",
        "value": [
          {
            "extensions": {
              "com.example.effective-window": {
                "days": 30
              }
            }
          }
        ]
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ],
  "metadata": {
    "requiredExtensions": [
      "com.example.effective-window"
    ]
  }
}
