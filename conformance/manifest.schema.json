{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://judgmentpack.org/schema/0.4.0/conformance/manifest.schema.json",
  "title": "Judgment Pack conformance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "suiteVersion",
    "specVersion",
    "status",
    "validationProfile",
    "readerProfiles",
    "diagnosticVocabulary",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "suiteVersion": {
      "const": "0.4.0"
    },
    "specVersion": {
      "const": "0.4.0"
    },
    "status": {
      "enum": ["draft", "candidate", "release"]
    },
    "validationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonSchemaDialect",
        "formatAssertionRequired",
        "rejectDuplicateObjectMembers"
      ],
      "properties": {
        "jsonSchemaDialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "formatAssertionRequired": {
          "const": true
        },
        "rejectDuplicateObjectMembers": {
          "const": true
        }
      }
    },
    "readerProfiles": {
      "description": "The ceiling profiles a reader runs the cases under (Core \u00a74.1). A case whose fixture declares the extended profile is run by a reader supporting it, under the extended value of every row.",
      "const": ["base", "extended"]
    },
    "diagnosticVocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory"],
      "properties": {
        "advisory": {
          "const": ["JPS-RULES-OVERLAP"]
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "extensionName": {
      "type": "string",
      "pattern": "^(?!org\\.judgmentpack\\.)[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "supportedExtensionName": {
      "description": "A name a supported-extension set may hold: an extension name, or a specification-defined name, which Core \u00a78.2 ignores when no conforming pack can require it.",
      "anyOf": [
        { "$ref": "#/$defs/extensionName" },
        { "enum": ["org.judgmentpack.annotations"] }
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^JPS-(?:CARRIER|STRUCTURE|SEMANTIC|CAPABILITY)-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        }
      }
    },
    "ruleOverlapDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "certainty",
        "severity",
        "path",
        "rules",
        "effect",
        "suggestedRewrite"
      ],
      "properties": {
        "code": {
          "const": "JPS-RULES-OVERLAP"
        },
        "certainty": {
          "enum": ["exact", "not-excluded"]
        },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["validate", "strict", "publish"],
          "properties": {
            "validate": { "const": "warning" },
            "strict": { "enum": ["warning", "error"] },
            "publish": { "enum": ["warning", "block"] }
          }
        },
        "path": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "outcome"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "outcome": { "type": "string", "minLength": 1 }
            }
          }
        },
        "overlap": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sharedValues"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
                },
                "sharedValues": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
                },
                "from": {
                  "$ref": "../judgment-pack-core.schema.json#/$defs/decimalString"
                },
                "fromInclusive": { "type": "boolean" },
                "to": {
                  "$ref": "../judgment-pack-core.schema.json#/$defs/decimalString"
                },
                "toInclusive": { "type": "boolean" }
              },
              "dependentRequired": {
                "from": ["fromInclusive"],
                "fromInclusive": ["from"],
                "to": ["toInclusive"],
                "toInclusive": ["to"]
              },
              "anyOf": [
                { "required": ["from"] },
                { "required": ["to"] }
              ]
            }
          ]
        },
        "witnessFacts": {
          "type": "object"
        },
        "effect": {
          "const": "Core §8 records conflict; the disposition is unresolved."
        },
        "suggestedRewrite": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ruleId", "when"],
          "properties": {
            "ruleId": { "type": "string", "minLength": 1 },
            "when": {
              "$ref": "../judgment-pack-core.schema.json#/$defs/condition"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "certainty": { "const": "exact" } },
            "required": ["certainty"]
          },
          "then": {
            "anyOf": [
              { "required": ["overlap"] },
              { "required": ["witnessFacts"] }
            ],
            "properties": {
              "severity": {
                "properties": {
                  "strict": { "const": "error" },
                  "publish": { "const": "block" }
                }
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["overlap"] },
                { "required": ["witnessFacts"] }
              ]
            },
            "properties": {
              "severity": {
                "properties": {
                  "strict": { "const": "warning" },
                  "publish": { "const": "warning" }
                }
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "layer",
        "expectedResult",
        "expectedDiagnostic",
        "focus",
        "specSection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?:advisory|carrier|structural|semantic|valid)/[a-z0-9][a-z0-9-]*\\.json$"
        },
        "layer": {
          "enum": ["carrier", "structural", "semantic"]
        },
        "expectedResult": {
          "enum": ["valid", "invalid", "unsupported"]
        },
        "expectedDiagnostic": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/diagnostic" }
          ]
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "specSection": {
          "type": "string",
          "pattern": "^§"
        },
        "supportedExtensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supportedExtensionName"
          },
          "uniqueItems": true
        },
        "expectedDiagnostics": {
          "description": "Optional. Every finding the case's one defect gives, where it gives more than one. Findings compare as a set of code and pointer pairs; expectedDiagnostic is the first item.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "expectedAdvisories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ruleOverlapDiagnostic"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expectedResult": { "const": "valid" }
            },
            "required": ["expectedResult"]
          },
          "then": {
            "properties": {
              "expectedDiagnostic": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "expectedDiagnostic": { "$ref": "#/$defs/diagnostic" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": { "pattern": "^advisory/" }
            },
            "required": ["path"]
          },
          "then": {
            "required": ["expectedAdvisories"],
            "properties": {
              "layer": { "const": "semantic" },
              "expectedResult": { "const": "valid" },
              "expectedDiagnostic": { "type": "null" }
            }
          },
          "else": {
            "not": { "required": ["expectedAdvisories"] }
          }
        },
        {
          "if": { "required": ["expectedDiagnostics"] },
          "then": { "properties": { "expectedResult": { "const": "invalid" } } }
        }
      ]
    }
  }
}
