{
  "specVersion": "0.4.0",
  "id": "https://example.com/judgment-packs/unresolved-value-set-nested",
  "version": "0.1.0",
  "title": "An unresolved reference under all and not",
  "decision": {
    "intent": "Exercise one rule of RFC 0031.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept a request in a priority tier.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "not",
            "condition": {
              "op": "fact",
              "path": "/request/tier",
              "operator": "in",
              "valueSet": "retired-tiers"
            }
          }
        ]
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ],
  "valueSets": [
    {
      "id": "priority-tiers",
      "entries": [
        {
          "value": "tier-1"
        },
        {
          "value": "tier-2"
        }
      ]
    }
  ]
}
