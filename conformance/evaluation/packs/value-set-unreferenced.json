{
  "specVersion": "0.5.0",
  "id": "https://example.com/judgment-packs/value-set-tiers",
  "version": "0.1.0",
  "title": "Priority tiers",
  "decision": {
    "intent": "Decide whether a request is on the priority track.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "priority-track",
      "description": "A request in a priority tier is accepted.",
      "when": {
        "op": "fact",
        "path": "/request/tier",
        "operator": "in",
        "value": [
          "tier-1",
          "tier-2",
          "tier-3"
        ]
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ],
  "valueSets": [
    {
      "id": "retired-tiers",
      "description": "Tiers no rule uses any more.",
      "entries": [
        {
          "value": "tier-8"
        },
        {
          "value": "tier-9"
        }
      ]
    }
  ],
  "escalation": {
    "triggers": [
      "unknown",
      "no-match"
    ],
    "target": {
      "kind": "queue",
      "name": "Priority review"
    }
  }
}
