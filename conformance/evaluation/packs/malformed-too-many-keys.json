{
  "specVersion": "0.4.0",
  "id": "https://example.com/judgment-packs/annotations-inert",
  "version": "0.1.0",
  "title": "Request intake",
  "decision": {
    "intent": "Decide whether an intake request is accepted or referred for review.",
    "question": "Is the request accepted?"
  },
  "applicability": {
    "op": "fact",
    "path": "/request/kind",
    "operator": "equals",
    "value": "intake"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "priority-tier",
      "description": "Accept a request in a priority tier.",
      "when": {
        "op": "fact",
        "path": "/request/tier",
        "operator": "in",
        "value": [
          "tier-1",
          "tier-2"
        ]
      },
      "outcome": "accept",
      "onUnknown": "escalate",
      "extensions": {
        "org.judgmentpack.annotations": {
          "key-00": "intake",
          "key-01": "intake",
          "key-02": "intake",
          "key-03": "intake",
          "key-04": "intake",
          "key-05": "intake",
          "key-06": "intake",
          "key-07": "intake",
          "key-08": "intake",
          "key-09": "intake",
          "key-10": "intake",
          "key-11": "intake",
          "key-12": "intake",
          "key-13": "intake",
          "key-14": "intake",
          "key-15": "intake",
          "key-16": "intake"
        }
      }
    },
    {
      "id": "flagged",
      "description": "Refer a flagged request.",
      "when": {
        "op": "fact",
        "path": "/request/flagged",
        "operator": "equals",
        "value": true
      },
      "outcome": "refer",
      "onUnknown": "ignore"
    }
  ],
  "escalation": {
    "triggers": [
      "not-applicable",
      "unknown",
      "conflict",
      "no-match"
    ],
    "target": {
      "kind": "human-role",
      "name": "Intake reviewer"
    }
  }
}
