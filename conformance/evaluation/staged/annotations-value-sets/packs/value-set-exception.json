{
  "specVersion": "0.4.0-draft",
  "id": "https://example.com/judgment-packs/value-set-tiers",
  "version": "0.1.0",
  "title": "Held tiers",
  "decision": {
    "intent": "Decide whether a request is on the priority track.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "priority-track",
      "description": "A request in a priority tier is accepted.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ],
  "exceptions": [
    {
      "id": "held-tier",
      "description": "Refer a request in a held tier.",
      "when": {
        "op": "fact",
        "path": "/request/tier",
        "operator": "in",
        "valueSet": "held-tiers"
      },
      "effect": "force-outcome",
      "outcome": "refer",
      "onUnknown": "escalate"
    }
  ],
  "valueSets": [
    {
      "id": "held-tiers",
      "entries": [
        {
          "value": "tier-8"
        },
        {
          "value": "tier-9"
        }
      ]
    }
  ],
  "escalation": {
    "triggers": [
      "unknown",
      "no-match"
    ],
    "target": {
      "kind": "queue",
      "name": "Priority review"
    }
  }
}
