{
  "specVersion": "0.4.0-draft",
  "id": "https://example.com/judgment-packs/value-set-tiers",
  "version": "0.1.0",
  "title": "Listed codes",
  "decision": {
    "intent": "Decide whether a request is on the priority track.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "priority-track",
      "description": "A request in a priority tier is accepted.",
      "when": {
        "op": "fact",
        "path": "/request/code",
        "operator": "in",
        "valueSet": "codes"
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ],
  "valueSets": [
    {
      "id": "codes",
      "entries": [
        {
          "value": 1
        },
        {
          "value": "true"
        },
        {
          "value": "1.00"
        },
        {
          "value": "e\u0301"
        },
        {
          "value": {
            "a": 1,
            "b": 2
          }
        },
        {
          "value": {
            "valueSet": "priority-tiers"
          }
        }
      ]
    }
  ],
  "escalation": {
    "triggers": [
      "unknown",
      "no-match"
    ],
    "target": {
      "kind": "queue",
      "name": "Priority review"
    }
  }
}
