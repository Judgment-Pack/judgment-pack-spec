{
  "specVersion": "0.4.0-draft",
  "id": "https://example.com/judgment-packs/value-set-shared",
  "version": "0.1.0",
  "title": "Expense category check",
  "decision": {
    "intent": "Decide whether an expense is approved or rejected by its category.",
    "question": "Is the expense approved?"
  },
  "outcomes": [
    {
      "id": "approve",
      "label": "Approve"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "prohibited-category",
      "description": "Reject an expense in a prohibited category.",
      "when": {
        "op": "fact",
        "path": "/expense/category",
        "operator": "in",
        "value": [
          "personal",
          "cash-equivalent",
          "gift-card"
        ]
      },
      "outcome": "reject",
      "onUnknown": "escalate"
    },
    {
      "id": "ordinary-category",
      "description": "Approve an expense outside the prohibited categories.",
      "when": {
        "op": "not",
        "condition": {
          "op": "fact",
          "path": "/expense/category",
          "operator": "in",
          "value": [
            "personal",
            "cash-equivalent"
          ]
        }
      },
      "outcome": "approve",
      "onUnknown": "escalate"
    }
  ],
  "escalation": {
    "triggers": [
      "unknown",
      "conflict",
      "no-match"
    ],
    "target": {
      "kind": "human-role",
      "name": "Finance reviewer"
    }
  }
}
