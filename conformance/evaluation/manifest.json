    {
      "id": "ordered-comparison-below-threshold",
      "origin": "constructed-decimal-ordering",
      "pack": "packs/decimal-threshold-fee.json",
      "facts": {
        "request": {
          "amount": "999.99"
        }
      },
      "supportedExtensions": [],
      "expectedDisposition": {
        "kind": "outcome",
        "outcomeId": "reduced-fee",
        "reasons": [],
        "handoff": {
          "state": "none"
        }
      },
      "focus": "ordered comparison is by mathematical value, not code point: 999.99 is below 1000 even though it sorts after it as a string",
      "specSection": "§7.4"
    },
    {
      "id": "ordered-comparison-ignores-decimal-scale",
      "origin": "constructed-decimal-ordering",
      "pack": "packs/decimal-threshold-fee.json",
      "facts": {
        "request": {
          "amount": "1000.00"
        }
      },
      "supportedExtensions": [],
      "expectedDisposition": {
        "kind": "outcome",
        "outcomeId": "standard-fee",
        "reasons": [],
        "handoff": {
          "state": "none"
        }
      },
      "focus": "1000.00 is at the threshold under ordered comparison and is not equal to the string 1000 under equals, so the exempt rule stays false and no conflict arises",
      "specSection": "§7.4"
    },
    {
      "id": "ordered-comparison-refuses-a-json-number",
      "origin": "constructed-decimal-ordering",
      "pack": "packs/decimal-threshold-fee.json",
      "facts": {
        "request": {
          "amount": 1000
        }
      },
      "supportedExtensions": [],
      "expectedDisposition": {
        "kind": "unresolved",
        "reasons": [
          "unknown"
        ],
        "handoff": {
          "state": "requested",
          "triggeredBy": [
            "unknown"
          ]
        }
      },
      "focus": "a JSON number is never coerced into an ordered comparison and is not equal to a decimal string, so both ordered rules are unknown and escalate",
      "specSection": "§7.4"
    }
