{
  "specVersion": "0.3.0",
  "id": "https://example.com/judgment-packs/decimal-operand-bare-fraction",
  "version": "0.1.0",
  "title": "Decimal operand with bare fraction",
  "decision": {
    "intent": "Exercise the ordered-operand decimal grammar.",
    "question": "Is a bare fraction decimal operand without an integer part rejected?"
  },
  "outcomes": [
    { "id": "accept", "label": "Accept" },
    { "id": "reject", "label": "Reject" }
  ],
  "rules": [
    {
      "id": "ordered-rule",
      "description": "Uses a decimal operand lacking an integer part before the point.",
      "when": {
        "op": "fact",
        "path": "/amount",
        "operator": "greater-than",
        "value": ".5"
      },
      "outcome": "accept",
      "onUnknown": "escalate"
    }
  ]
}
