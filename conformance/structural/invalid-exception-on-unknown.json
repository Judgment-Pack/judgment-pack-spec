{
  "specVersion": "0.3.0",
  "id": "https://example.com/judgment-packs/invalid-exception-on-unknown",
  "version": "0.1.0",
  "title": "Invalid exception onUnknown",
  "decision": {
    "intent": "Exercise the escalate exception branch.",
    "question": "Should the exception require escalation?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "reject",
      "label": "Reject"
    }
  ],
  "rules": [
    {
      "id": "base-rule",
      "description": "A declared base rule.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "ignore"
    }
  ],
  "exceptions": [
    {
      "id": "escalation",
      "description": "Requires escalation without a target rule or outcome.",
      "when": {
        "op": "literal",
        "value": true
      },
      "effect": "escalate",
      "onUnknown": "custom"
    }
  ]
}
