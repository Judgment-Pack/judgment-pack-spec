{
  "specVersion": "0.4.0",
  "id": "https://example.com/judgment-packs/annotations-invisible-filter-twin",
  "version": "0.1.0",
  "title": "Two rules whose labels display alike",
  "decision": {
    "intent": "Exercise one rule of RFC 0031.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept every request.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "accept",
      "onUnknown": "ignore",
      "extensions": {
        "org.judgmentpack.annotations": {
          "category": "intake"
        }
      }
    },
    {
      "id": "refer-request",
      "description": "Refer every request.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "refer",
      "onUnknown": "ignore",
      "extensions": {
        "org.judgmentpack.annotations": {
          "category": "intake\u200b"
        }
      }
    }
  ]
}
