{
  "specVersion": "0.3.0",
  "id": "https://example.com/judgment-packs/escalate-forbidden-target-rule",
  "version": "0.1.0",
  "title": "Escalate exception with forbidden targetRule",
  "decision": {
    "intent": "Exercise exception discriminators.",
    "question": "Is an escalate effect carrying a targetRule operand rejected?"
  },
  "outcomes": [
    { "id": "accept", "label": "Accept" },
    { "id": "reject", "label": "Reject" }
  ],
  "rules": [
    {
      "id": "literal-rule",
      "description": "A structurally minimal rule.",
      "when": { "op": "literal", "value": true },
      "outcome": "accept",
      "onUnknown": "ignore"
    }
  ],
  "exceptions": [
    {
      "id": "escalation-test",
      "description": "Intentionally carries a forbidden targetRule operand.",
      "when": { "op": "literal", "value": true },
      "effect": "escalate",
      "targetRule": "literal-rule",
      "onUnknown": "ignore"
    }
  ]
}
