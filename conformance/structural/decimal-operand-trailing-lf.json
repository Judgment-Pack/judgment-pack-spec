{
  "specVersion": "0.5.0",
  "id": "https://example.com/judgment-packs/decimal-operand-trailing-lf",
  "version": "0.1.0",
  "title": "A decimal operand that ends in a line feed",
  "decision": {
    "intent": "Exercise one rule of RFC 0031.",
    "question": "Is the request accepted?"
  },
  "outcomes": [
    {
      "id": "accept",
      "label": "Accept"
    },
    {
      "id": "refer",
      "label": "Refer for review"
    }
  ],
  "rules": [
    {
      "id": "accept-request",
      "description": "Accept a request for more than ten units.",
      "when": {
        "op": "fact",
        "path": "/request/units",
        "operator": "greater-than",
        "value": "10\n"
      },
      "outcome": "accept",
      "onUnknown": "ignore"
    }
  ]
}
