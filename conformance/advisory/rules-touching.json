{
  "specVersion": "0.3.0",
  "id": "https://example.com/judgment-packs/rules-touching",
  "version": "0.1.0",
  "title": "Touching rule ranges",
  "decision": {
    "intent": "Assign a score band.",
    "question": "Which score band applies?"
  },
  "outcomes": [
    { "id": "medium", "label": "Medium" },
    { "id": "high", "label": "High" }
  ],
  "rules": [
    {
      "id": "r-medium",
      "description": "Scores below 70 are medium.",
      "when": {
        "op": "fact",
        "path": "/score",
        "operator": "less-than",
        "value": "70"
      },
      "outcome": "medium",
      "onUnknown": "escalate"
    },
    {
      "id": "r-high",
      "description": "Scores of at least 70 are high.",
      "when": {
        "op": "fact",
        "path": "/score",
        "operator": "greater-than-or-equal",
        "value": "70"
      },
      "outcome": "high",
      "onUnknown": "escalate"
    }
  ]
}
