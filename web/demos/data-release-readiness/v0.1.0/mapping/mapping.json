                  {
                    "op": "equals",
                    "field": "/status",
                    "to": "not_found"
                  },
                  {
                    "op": "isTrue",
                    "field": "/checkedSuccessfully"
                  }
                ]
              },
              "claim": {
                "facts": [],
                "evidence": {
                  "orchestrator-record": "absent"
