                "op": "equals",
                "field": "/status",
                "to": "found"
              },
              "claim": {
                "facts": [
                  {
                    "pointer": "/review/context",
                    "from": "/data/review_context"
                  },
                  {
                    "pointer": "/review/purpose",
                    "from": "/data/review_purpose"
                  },
                  {
                    "pointer": "/pipeline/completed",
                    "from": "/data/pipeline_completed"
                  }
                ],
                "evidence": {
                  "orchestrator-record": "present"
                },
                "acquisitionStatus": "resolved"
              },
              "reason": "matching-case-revision-and-scope"
            },
            {
              "when": {
                "op": "always"
              },
              "claim": {
                "facts": [],
                "evidence": {
                  "orchestrator-record": "unknown"
                },
                "acquisitionStatus": "unknown"
              },
              "reason": "lookup-unavailable-or-incomplete"
