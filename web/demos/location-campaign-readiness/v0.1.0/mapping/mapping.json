            {
              "when": {
                "op": "all",
                "of": [
                  {
                    "op": "equals",
                    "field": "/status",
                    "to": "found"
                  },
                  {
                    "op": "not",
                    "of": {
                      "op": "any",
                      "of": [
                        {
                          "op": "equals",
                          "field": "/data/location_open",
                          "to": true
                        },
                        {
                          "op": "equals",
                          "field": "/data/location_open",
                          "to": false
                        }
                      ]
                    }
                  }
