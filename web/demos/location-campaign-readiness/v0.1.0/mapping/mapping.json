            {
              "when": {
                "op": "all",
                "of": [
                  {
                    "op": "equals",
                    "field": "/status",
                    "to": "not_found"
                  },
                  {
                    "op": "isTrue",
                    "field": "/checkedSuccessfully"
                  }
                ]
              },
              "claim": {
                "facts": [],
                "evidence": {
                  "location-record": "absent"
                },
                "acquisitionStatus": "absent"
              },
              "reason": "record-not-found"
            },
            {
              "when": {
                "op": "equals",
                "field": "/status",
                "to": "found"
              },
              "claim": {
                "facts": [
                  {
                    "pointer": "/review/context",
                    "from": "/data/review_context"
                  },
                  {
                    "pointer": "/review/purpose",
                    "from": "/data/review_purpose"
                  },
                  {
                    "pointer": "/location/open",
                    "from": "/data/location_open"
                  }
                ],
                "evidence": {
                  "location-record": "present"
                },
                "acquisitionStatus": "resolved"
              },
              "reason": "matching-case-revision-and-scope"
            },
            {
              "when": {
                "op": "always"
              },
              "claim": {
                "facts": [],
                "evidence": {
                  "location-record": "unknown"
                },
                "acquisitionStatus": "unknown"
              },
              "reason": "lookup-unavailable-or-incomplete"
            }
          ]
        }
