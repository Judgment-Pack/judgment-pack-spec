                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/channel/ready",
                "operator": "equals",
                "value": true
              }
            ]
          },
          {
            "op": "all",
            "conditions": [
              {
                "op": "fact",
                "path": "/offer/spendCAD",
                "operator": "greater-than-or-equal",
                "value": "0"
              },
              {
                "op": "fact",
                "path": "/offer/spendCAD",
                "operator": "less-than-or-equal",
                "value": "1000000"
              }
            ]
          },
          {
            "op": "fact",
            "path": "/brand/restrictedClaim",
            "operator": "equals",
            "value": false
          },
          {
            "op": "fact",
            "path": "/offer/spendCAD",
            "operator": "less-than-or-equal",
            "value": "1000"
          }
        ]
      },
      "outcome": "ready",
      "onUnknown": "escalate",
      "sourceRefs": [
        "demo-policy"
      ],
      "evidenceRequirementRefs": [
        "location-record",
        "offer-record",
        "brand-record",
        "channel-record"
      ],
