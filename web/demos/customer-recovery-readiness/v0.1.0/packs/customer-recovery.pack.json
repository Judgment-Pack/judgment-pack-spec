{
  "specVersion": "0.2.0-draft",
  "id": "https://example.invalid/packs/customer-recovery",
  "version": "0.1.0",
  "title": "Customer recovery evidence readiness",
  "description": "Synthetic demonstration. This gate does not issue credits, contact customers or close tickets. All records and the CAD 500 review threshold are fictional; no Qualtrics connection, employer policy or endorsement is represented.",
  "decision": {
    "intent": "Is this proposed customer remedy ready for accountable owner review? Reconcile matching source records and identify the next accountable owner.",
    "question": "Is this proposed customer remedy ready for accountable owner review?"
  },
  "applicability": {
    "op": "all",
    "conditions": [
      {
        "op": "fact",
        "path": "/review/context",
        "operator": "equals",
        "value": "synthetic-demo"
      },
      {
        "op": "fact",
        "path": "/review/purpose",
        "operator": "equals",
        "value": "customer-recovery-review"
      }
    ]
  },
  "evidenceRequirements": [
    {
      "id": "feedback-record",
      "description": "Customer feedback and case record matching caseId, remedyRevision, accountScope.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "service-record",
      "description": "Service investigation and proposed remedy matching caseId, remedyRevision, accountScope.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "approval-record",
      "description": "Remedy approval record matching caseId, remedyRevision, accountScope.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "account-record",
      "description": "Account owner and contact permission check matching caseId, remedyRevision, accountScope.",
      "required": true,
      "kind": "document"
    }
  ],
  "sources": [
    {
      "id": "demo-policy",
      "title": "Customer recovery evidence readiness — fictional policy v0.1.0",
      "publisher": "Judgment Pack demo",
      "locator": {
        "kind": "path",
        "value": "sources/policy/demo-policy.md"
      },
      "citation": {
        "location": "Decision gate",
        "excerpt": "Each record must match the submitted case, revision and scope. Missing or mismatched evidence cannot establish readiness. Positive results require accountable human review."
      },
      "rights": "Original synthetic example; no employer or customer policy is represented."
    }
  ],
  "outcomes": [
    {
      "id": "ready",
      "label": "Ready for recovery owner review",
      "description": "Ready for recovery owner review under the fictional evidence gate; no external action is authorized."
    },
    {
      "id": "review",
      "label": "Additional commercial review",
      "description": "Additional commercial review under the fictional evidence gate; no external action is authorized."
    },
    {
      "id": "hold",
      "label": "Hold the proposed remedy",
      "description": "Hold the proposed remedy under the fictional evidence gate; no external action is authorized."
    }
