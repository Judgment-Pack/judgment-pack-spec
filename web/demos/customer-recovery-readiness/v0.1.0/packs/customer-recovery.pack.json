  "rules": [
    {
      "id": "ready",
      "description": "Matching positive records within this demo threshold",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "all",
            "conditions": [
              {
                "op": "fact",
                "path": "/feedback/caseLinked",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/service/issueVerified",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/approval/remedyApproved",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/account/ownerAssigned",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/account/contactPermitted",
                "operator": "equals",
                "value": true
              }
            ]
          },
          {
            "op": "all",
            "conditions": [
              {
                "op": "fact",
                "path": "/remedy/amountCAD",
                "operator": "greater-than-or-equal",
                "value": "0"
              },
              {
                "op": "fact",
                "path": "/remedy/amountCAD",
                "operator": "less-than-or-equal",
                "value": "100000"
              }
            ]
          },
          {
            "op": "fact",
            "path": "/approval/exceptionRequested",
            "operator": "equals",
            "value": false
          },
          {
            "op": "fact",
            "path": "/remedy/amountCAD",
            "operator": "less-than-or-equal",
            "value": "500"
          }
        ]
      },
      "outcome": "ready",
      "onUnknown": "escalate",
      "sourceRefs": [
        "demo-policy"
      ],
      "evidenceRequirementRefs": [
        "feedback-record",
        "service-record",
        "approval-record",
        "account-record"
      ],
      "rationale": "Matching positive records within this demo threshold. This is a fictional policy; the named owner remains accountable."
    },
    {
