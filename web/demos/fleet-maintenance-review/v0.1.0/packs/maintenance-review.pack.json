{
  "specVersion": "0.2.0-draft",
  "id": "https://example.invalid/packs/maintenance-review",
  "version": "0.1.0",
  "title": "Maintenance recommendation evidence review",
  "description": "Synthetic demonstration. This is a planning evidence gate, never a roadworthiness, dispatch or repair authorization. No model is called, safety is not certified, and a safety concern always requests a qualified human review.",
  "decision": {
    "intent": "Is this maintenance recommendation ready for a planner to review? Reconcile matching source records and identify the next accountable owner.",
    "question": "Is this maintenance recommendation ready for a planner to review?"
  },
  "applicability": {
    "op": "all",
    "conditions": [
      {
        "op": "fact",
        "path": "/review/context",
        "operator": "equals",
        "value": "synthetic-demo"
      },
      {
        "op": "fact",
        "path": "/review/purpose",
        "operator": "equals",
        "value": "maintenance-planning"
      }
    ]
  },
  "evidenceRequirements": [
    {
      "id": "asset-record",
      "description": "Asset and component record matching vehicleId, observationBatch, componentId.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "diagnostic-record",
      "description": "Diagnostic observation report matching vehicleId, observationBatch, componentId.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "inspection-record",
      "description": "Technician inspection record matching vehicleId, observationBatch, componentId.",
      "required": true,
      "kind": "document"
    },
    {
      "id": "workorder-record",
      "description": "Work-order coordination check matching vehicleId, observationBatch, componentId.",
      "required": true,
      "kind": "document"
    }
  ],
  "sources": [
    {
      "id": "demo-policy",
      "title": "Maintenance recommendation evidence review — fictional policy v0.1.0",
      "publisher": "Judgment Pack demo",
      "locator": {
        "kind": "path",
        "value": "sources/policy/demo-policy.md"
      },
      "citation": {
        "location": "Decision gate",
        "excerpt": "Each record must match the submitted case, revision and scope. Missing or mismatched evidence cannot establish readiness. Positive results require accountable human review."
      },
      "rights": "Original synthetic example; no employer or customer policy is represented."
    }
  ],
  "outcomes": [
    {
      "id": "ready",
      "label": "Ready for planner review",
      "description": "Ready for planner review under the fictional evidence gate; no external action is authorized."
    },
    {
      "id": "review",
      "label": "Priority planner review",
      "description": "Priority planner review under the fictional evidence gate; no external action is authorized."
    },
    {
      "id": "hold",
      "label": "Hold for investigation",
      "description": "Hold for investigation under the fictional evidence gate; no external action is authorized."
    }
  ],
  "rules": [
    {
      "id": "ready",
      "description": "Matching positive records within this demo threshold",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "all",
            "conditions": [
              {
                "op": "fact",
                "path": "/asset/inScope",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/diagnostic/signalSupported",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/inspection/faultConfirmed",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/workorder/noDuplicateOpen",
                "operator": "equals",
                "value": true
              }
            ]
          },
          {
            "op": "all",
            "conditions": [
              {
                "op": "fact",
                "path": "/diagnostic/priorityScore",
                "operator": "greater-than-or-equal",
                "value": "0"
              },
              {
                "op": "fact",
                "path": "/diagnostic/priorityScore",
                "operator": "less-than-or-equal",
                "value": "10"
              }
            ]
          },
          {
            "op": "fact",
            "path": "/inspection/safetyConcern",
            "operator": "equals",
            "value": false
          },
          {
            "op": "fact",
            "path": "/diagnostic/priorityScore",
            "operator": "less-than-or-equal",
            "value": "5"
          }
        ]
      },
      "outcome": "ready",
      "onUnknown": "escalate",
      "sourceRefs": [
        "demo-policy"
      ],
      "evidenceRequirementRefs": [
        "asset-record",
        "diagnostic-record",
        "inspection-record",
        "workorder-record"
      ],
      "rationale": "Matching positive records within this demo threshold. This is a fictional policy; the named owner remains accountable."
    },
    {
      "id": "review-boundary",
      "description": "Complete records requiring additional owner review",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "all",
            "conditions": [
              {
                "op": "fact",
                "path": "/asset/inScope",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/diagnostic/signalSupported",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/inspection/faultConfirmed",
                "operator": "equals",
                "value": true
              },
              {
                "op": "fact",
                "path": "/workorder/noDuplicateOpen",
                "operator": "equals",
                "value": true
              }
            ]
          },
          {
            "op": "all",
            "conditions": [
              {
                "op": "fact",
                "path": "/diagnostic/priorityScore",
                "operator": "greater-than-or-equal",
                "value": "0"
              },
              {
                "op": "fact",
                "path": "/diagnostic/priorityScore",
                "operator": "less-than-or-equal",
                "value": "10"
              }
            ]
          },
          {
            "op": "fact",
            "path": "/inspection/safetyConcern",
            "operator": "equals",
            "value": false
          },
          {
            "op": "fact",
            "path": "/diagnostic/priorityScore",
            "operator": "greater-than",
            "value": "5"
          }
        ]
      },
      "outcome": "review",
      "onUnknown": "escalate",
      "sourceRefs": [
        "demo-policy"
      ],
      "evidenceRequirementRefs": [
        "asset-record",
        "diagnostic-record",
        "inspection-record",
        "workorder-record"
      ],
      "rationale": "Complete records requiring additional owner review. This is a fictional policy; the named owner remains accountable."
    },
    {
      "id": "known-blocker",
      "description": "A recorded prerequisite is explicitly false",
      "when": {
        "op": "any",
        "conditions": [
          {
            "op": "fact",
            "path": "/asset/inScope",
            "operator": "equals",
            "value": false
          },
          {
            "op": "fact",
            "path": "/diagnostic/signalSupported",
            "operator": "equals",
            "value": false
          },
          {
            "op": "fact",
            "path": "/inspection/faultConfirmed",
            "operator": "equals",
            "value": false
          },
          {
            "op": "fact",
            "path": "/workorder/noDuplicateOpen",
            "operator": "equals",
            "value": false
          }
        ]
      },
      "outcome": "hold",
      "onUnknown": "escalate",
      "sourceRefs": [
        "demo-policy"
      ],
      "evidenceRequirementRefs": [
        "asset-record",
        "diagnostic-record",
        "inspection-record",
        "workorder-record"
      ],
      "rationale": "A recorded prerequisite is explicitly false. This is a fictional policy; the named owner remains accountable."
    }
  ],
  "exceptions": [
    {
      "id": "human-exception",
      "description": "Explicit exception requires owner review before ordinary outcome resolution.",
      "when": {
        "op": "fact",
        "path": "/inspection/safetyConcern",
        "operator": "equals",
        "value": true
      },
      "effect": "escalate",
      "onUnknown": "escalate",
      "sourceRefs": [
        "demo-policy"
      ]
    }
  ],
  "fallbackOutcome": "hold",
  "escalation": {
    "triggers": [
      "not-applicable",
      "missing-required-evidence",
      "unknown"
    ],
    "target": {
      "kind": "human-role",
      "name": "Fleet maintenance planner"
    },
    "message": "The Fleet maintenance planner coordinates the source owner. Inspect the acquisition diagnosis and retain this run before correcting inputs. No notification has been sent."
  },
  "metadata": {
    "authors": [
      "Codex — synthetic demo prepared for the maintainer"
    ],
    "createdAt": "2026-09-28T18:26:06.719035Z",
    "license": "Apache-2.0"
  }
}
