{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:judgment-pack:draft:rfc0029:retained-column-1",
  "title": "Draft retained-column/1 fragments; not a published schema",
  "description": "Structural checks only. UTF8 bytes, scalar validity, duplicates, embedded JSON, distinct names, spellings and semantics require the proposed reader.",
  "$defs": {
    "conversion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "const": "1"
            },
            "column": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "kind": {
              "enum": [
                "text",
                "decimal",
                "number",
                "research-value"
              ]
            }
          },
          "required": [
            "contractVersion",
            "column",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "contractVersion": {
              "const": "1"
            },
            "column": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "kind": {
              "const": "boolean"
            },
            "trueValue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "falseValue": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "contractVersion",
            "column",
            "kind",
            "trueValue",
            "falseValue"
          ],
          "additionalProperties": false
        }
      ]
    },
    "availability": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "required": [
        "contractVersion",
        "column"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "conversion": {
          "$ref": "#/$defs/conversion"
        }
      },
      "required": [
        "target",
        "source",
        "conversion"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source": {
          "type": "string",
          "pattern": "^(?:/(?:[^~]|~[01])*)*$"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        }
      },
      "required": [
        "requirement",
        "source",
        "availability"
      ],
      "additionalProperties": false
    },
    "declarationEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fieldJson": {
          "type": "string",
          "maxLength": 16384
        }
      },
      "required": [
        "name",
        "fieldJson"
      ],
      "additionalProperties": false
    },
    "declaration": {
      "type": "object",
      "properties": {
        "recipeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fields": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/declarationEntry"
          }
        }
      },
      "required": [
        "recipeRevision",
        "fields"
      ],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "supported",
            "interpretation",
            "missing",
            "conflicting",
            "inaccessible",
            "stale"
          ]
        },
        "valueJson": {
          "type": "string",
          "maxLength": 4194304
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "research": {
      "type": "object",
      "properties": {
        "recordRecipeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "declaration": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/declaration"
            }
          ]
        },
        "fields": {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "recordRecipeRevision",
        "declaration",
        "fields"
      ],
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "origin": {
          "enum": [
            "asserted",
            "generated"
          ]
        },
        "values": {
          "type": "object",
          "maxProperties": 1000,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16000
          }
        },
        "research": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/research"
            }
          ]
        }
      },
      "required": [
        "contractVersion",
        "origin",
        "values",
        "research"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "asserted"
              }
            }
          },
          "then": {
            "properties": {
              "research": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "research": {
                "$ref": "#/$defs/research"
              }
            }
          }
        }
      ]
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "missing"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "present"
            },
            "json": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "json"
          ],
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "value"
            },
            "json": {
              "type": "string"
            }
          },
          "required": [
            "state",
            "json"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "omitted"
            },
            "reason": {
              "enum": [
                "missing",
                "blank",
                "legacy-null",
                "unavailable"
              ]
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "researchIdentity": {
      "type": "object",
      "properties": {
        "recipeRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "fieldSha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "recipeRevision",
        "fieldSha256"
      ],
      "additionalProperties": false
    },
    "columnTransformation": {
      "type": "object",
      "properties": {
        "contractVersion": {
          "const": "1"
        },
        "column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "researchIdentity": {
          "$ref": "#/$defs/researchIdentity"
        }
      },
      "required": [
        "contractVersion",
        "column",
        "input",
        "result"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/fact"
    },
    {
      "$ref": "#/$defs/evidence"
    },
    {
      "$ref": "#/$defs/frame"
    },
    {
      "$ref": "#/$defs/columnTransformation"
    }
  ]
}
