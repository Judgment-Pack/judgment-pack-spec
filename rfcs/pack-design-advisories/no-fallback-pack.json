{
  "specVersion": "0.3.0",
  "id": "https://example.com/judgment-packs/advisory-report",
  "version": "0.1.0",
  "title": "Synthetic pack-design advisory report",
  "decision": {
    "intent": "Exercise finite-domain diagnostics.",
    "question": "Which outcome applies?"
  },
  "outcomes": [
    {
      "id": "medium",
      "label": "Medium"
    },
    {
      "id": "high",
      "label": "High"
    },
    {
      "id": "manual",
      "label": "Manual"
    }
  ],
  "rules": [
    {
      "id": "r-medium",
      "description": "At least 40.",
      "when": {
        "op": "fact",
        "path": "/score",
        "operator": "greater-than-or-equal",
        "value": "40"
      },
      "outcome": "medium",
      "onUnknown": "ignore"
    },
    {
      "id": "r-also-medium",
      "description": "At least 70.",
      "when": {
        "op": "fact",
        "path": "/score",
        "operator": "greater-than-or-equal",
        "value": "70"
      },
      "outcome": "medium",
      "onUnknown": "ignore"
    },
    {
      "id": "r-impossible",
      "description": "Contradictory thresholds.",
      "when": {
        "op": "all",
        "conditions": [
          {
            "op": "fact",
            "path": "/score",
            "operator": "greater-than-or-equal",
            "value": "70"
          },
          {
            "op": "fact",
            "path": "/score",
            "operator": "less-than",
            "value": "40"
          }
        ]
      },
      "outcome": "high",
      "onUnknown": "ignore"
    },
    {
      "id": "r-suppressed",
      "description": "Always suppressed.",
      "when": {
        "op": "literal",
        "value": true
      },
      "outcome": "high",
      "onUnknown": "ignore"
    }
  ],
  "exceptions": [
    {
      "id": "e-medium",
      "description": "Force medium in two modes.",
      "when": {
        "op": "fact",
        "path": "/mode",
        "operator": "in",
        "value": [
          "medium",
          "conflict"
        ]
      },
      "effect": "force-outcome",
      "outcome": "medium",
      "onUnknown": "ignore"
    },
    {
      "id": "e-high",
      "description": "Force high in two modes.",
      "when": {
        "op": "fact",
        "path": "/mode",
        "operator": "in",
        "value": [
          "high",
          "conflict"
        ]
      },
      "effect": "force-outcome",
      "outcome": "high",
      "onUnknown": "ignore"
    },
    {
      "id": "e-suppress",
      "description": "Suppress the named rule.",
      "when": {
        "op": "literal",
        "value": true
      },
      "effect": "suppress-rule",
      "targetRule": "r-suppressed",
      "onUnknown": "ignore"
    },
    {
      "id": "e-review",
      "description": "Review blocks resolution.",
      "when": {
        "op": "fact",
        "path": "/review",
        "operator": "equals",
        "value": true
      },
      "effect": "escalate",
      "onUnknown": "escalate"
    }
  ]
}
