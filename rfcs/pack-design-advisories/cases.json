    {
      "id": "same-outcome-agreement",
      "patch": {
        "rules": [
          {
            "id": "r-medium",
            "description": "At least 40.",
            "when": {
              "op": "fact",
              "path": "/score",
              "operator": "greater-than-or-equal",
              "value": "40"
            },
            "outcome": "medium",
            "onUnknown": "escalate"
          },
          {
            "id": "r-also-medium",
            "description": "At least 70.",
            "when": {
              "op": "fact",
              "path": "/score",
              "operator": "greater-than-or-equal",
              "value": "70"
            },
            "outcome": "medium",
            "onUnknown": "escalate"
          }
        ]
      },
      "input": {
        "facts": {
          "score": "70"
        },
        "evidence": {}
      },
      "expected": {
        "kind": "outcome",
        "outcome": "medium",
        "reasons": [],
        "candidates": [
          "r-medium",
          "r-also-medium"
        ],
        "skipped": [],
        "fallback": false
      }
    },
