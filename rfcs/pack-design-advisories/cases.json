              "op": "fact",
              "path": "/score",
              "operator": "greater-than-or-equal",
              "value": "70"
            },
            "outcome": "high",
            "onUnknown": "escalate"
          }
        ]
      },
      "input": {
        "facts": {
          "score": "70.00"
