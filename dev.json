{
  "version": 1,
  "toolchains": {
    "node": {"version": "22"},
    "python": {"version": "3.12", "venv": ".venv"}
  },
  "setup": [
    {"name": "python-deps", "run": "python3 -m pip install --disable-pip-version-check -r requirements-dev.txt", "toolchain": "python", "timeout": 600}
  ],
  "checks": [
    {"name": "local-paths", "run": "scripts/local-paths.sh", "toolchain": "shell"},
    {"name": "agent-docs", "run": "scripts/sync-agent-docs.sh --check .", "toolchain": "shell", "summary": "^sync-agent-docs:"},
    {"name": "diff-check", "run": "git diff --check \"$(git hash-object -t tree /dev/null)\"", "toolchain": "shell"},
    {"name": "repository-tests", "run": "python3 -m unittest discover -s tests -v", "toolchain": "node", "summary": "^(Ran |OK|FAILED)", "timeout": 1800},
    {"name": "policy-prototype", "run": "python3 -m unittest discover -s rfcs/policy-companion-prototype -p 'test_*.py' -v", "toolchain": "python", "summary": "^(Ran |OK|FAILED)", "timeout": 600},
    {"name": "policy-contract", "run": "python3 -m unittest discover -s rfcs/policy-companion-contract -p 'test_*.py' -v", "toolchain": "python", "summary": "^(Ran |OK|FAILED)", "timeout": 600},
    {"name": "policy-official-draft", "run": "python3 -m unittest discover -s conformance/policy/1.0.0 -p 'test_*.py' -v", "toolchain": "python", "summary": "^(Ran |OK|FAILED)", "timeout": 600}
  ],
  "handover": {
    "boundary_paths": ["schema", "spec"],
    "shared_paths": ["conformance", "rfcs", "examples"]
  }
}
