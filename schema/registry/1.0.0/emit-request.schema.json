{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://judgmentpack.org/schema/registry/1.0.0/emit-request.schema.json",
  "title": "Registry companion 1.0.0: emit request",
  "description": "Released on registry-v1.0.0 with spec/registry.md, which governs where they differ. An emit request (section 11.2), closed, in its resolved form or its facts form.",
  "$comment": "That options satisfy the manifest's options schema, that declarations and their pins agree and are sorted by kind, that resolved follows the manifest's environments, that factsContracts are sorted by id and version, and the bound of 64 MiB (section 11.2) are the host's and the emitter's to check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "emitRequestVersion",
    "emitter",
    "options"
  ],
  "properties": {
    "emitRequestVersion": {
      "const": "1.0.0"
    },
    "emitter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "https://judgmentpack.org/schema/registry/1.0.0/common.schema.json#/$defs/absoluteUri"
        },
        "version": {
          "$ref": "https://judgmentpack.org/schema/registry/1.0.0/common.schema.json#/$defs/version"
        }
      }
    },
    "options": true,
    "declarations": {
      "type": "array",
      "items": {
        "$ref": "https://judgmentpack.org/schema/registry/1.0.0/kind-declaration.schema.json"
      }
    },
    "resolved": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://judgmentpack.org/schema/registry/1.0.0/resolved-registry.schema.json"
      }
    },
    "factsContracts": {
      "type": "array",
      "items": {
        "$ref": "https://judgmentpack.org/schema/registry/1.0.0/facts-contract.schema.json"
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "declarations",
        "resolved"
      ],
      "not": {
        "required": [
          "factsContracts"
        ]
      }
    },
    {
      "required": [
        "factsContracts"
      ],
      "properties": {
        "declarations": false,
        "resolved": false
      }
    }
  ]
}
