# Rows staged for a later suiteVersion are in no corpus (conformance/evaluation/staged/README.md).
# A release bundle is built with `git archive` (tools/build_release.py), which honors export-ignore,
# so no bundle ever carries a staged row, whatever is staged when a release is cut.
conformance/evaluation/staged export-ignore
conformance/evaluation/staged/** export-ignore

# The checkpoint witness vectors are staged since RFC 0017's acceptance, in no corpus until the next
# specVersion opens (conformance/witness/README.md), so no bundle carries them. They are the
# reference gateway's bytes, held to their SHA-256 digests, so no checkout may convert a line ending
# in them either.
conformance/witness export-ignore
conformance/witness/** export-ignore -text

# The dialect vectors are staged since RFC 0018's acceptance, in no corpus until the next
# specVersion opens (conformance/dialect/README.md), so no bundle carries them. They are the
# reference Runner's bytes, so no checkout may convert a line ending in them. The companion document
# they belong to, spec/dialect.md, is published and no longer export-ignore.
conformance/dialect export-ignore
conformance/dialect/** export-ignore -text

# The companion document RFC 0020 proposes is normative for nothing while the RFC is a draft,
# so no bundle carries it; acceptance removes this line, as for RFC 0018's Draft.
spec/workflow.md export-ignore

# The staged draft Core specVersion 0.4.0-draft carries RFC 0031, a Draft (conformance/staged/README.md).
# Its schema, its text, its document cases and its example are normative for nothing and in no corpus,
# so no bundle carries them. Its evaluation rows are under conformance/evaluation/staged, above.
# The record-shape catalog still lists the staged schema's shape and digest (catalog/README.md).
schema/staged export-ignore
schema/staged/** export-ignore
spec/staged export-ignore
spec/staged/** export-ignore
conformance/staged export-ignore
conformance/staged/** export-ignore
examples/staged export-ignore
examples/staged/** export-ignore

# Independently packaged Policy fixture/schema bytes must never undergo text conversion.
schema/policy/** -text
conformance/policy/** -text

# Whitespace is the content of these files: a test case about trailing whitespace, and review records
# that quote lines as they were written. git diff --check (dev.json) skips them.
conformance/carrier/trailing-whitespace.json -whitespace
rfcs/reviews/*.md -whitespace

# New selected leaf resources retain exact bytes; historical staged namespaces keep their rules.
schema/retained-column/** -text
conformance/retained-column/** -text
